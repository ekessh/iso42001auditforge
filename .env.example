# SPDX-License-Identifier: BUSL-1.1
# AuditForge ISO 42001 — root example env file. Copy to `.env.local` for local dev.

# --- Database -----------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/auditforge

# --- Audit ledger signing (Ed25519) ------------------------------------------
# Base64-encoded PKCS#8 DER (48 bytes) Ed25519 private key. Used by the
# software signing provider; production deployments substitute the
# PKCS#11 / KMS / WebAuthn provider via packages/signing/providers.
SIGNING_PRIVATE_KEY_BASE64=
SIGNING_KEY_ID=auditforge-dev-key-001

# --- RFC 3161 TSA -------------------------------------------------------------
# URL of the TimeStamp Authority. freetsa.org is fine for development. In
# production, use a TSA whose root cert is trusted by the recipient's
# verification stack (see ETSI TS 119 612 trust lists for EU/UK auditors).
TSA_URL=https://freetsa.org/tsr
# How often the AuditLedgerService anchors a batch of events via TSA. Default
# is 60 s — every event below this rate is anchored individually; bursts are
# anchored as one batch covering the chain head at flush time.
LEDGER_ANCHOR_INTERVAL_MS=60000

# --- Reports ------------------------------------------------------------------
# Filesystem directory under which the report-engine writes signed DOCX/PDF/A-3
# bundles. Must be on a tamper-resistant volume in production (WORM, S3 Object
# Lock, or equivalent).
REPORT_OUTPUT_DIR=./var/reports

# --- LLM provider tier (see packages/llm-provider) ---------------------------
LLM_LOCAL_OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_AIR_GAP_MODE=false
