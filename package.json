{
  "name": "auditforge-iso42001",
  "version": "0.0.0",
  "private": true,
  "description": "AuditForge ISO 42001 - Workbench for ISO/IEC 42001 Lead Auditors (BUSL-1.1)",
  "license": "BUSL-1.1",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel --filter './apps/**' dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm -r test:integration",
    "test:e2e": "pnpm --filter @auditforge/e2e test",
    "test:load": "pnpm --filter @auditforge/load test",
    "db:migrate": "pnpm --filter @auditforge/db migrate",
    "db:seed": "pnpm --filter @auditforge/db seed",
    "db:studio": "pnpm --filter @auditforge/db studio",
    "license-check": "node scripts/license-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "eslint": "^9.11.0",
    "@typescript-eslint/parser": "^8.6.0",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "vitest": "^2.1.1",
    "tsx": "^4.19.1"
  }
}
