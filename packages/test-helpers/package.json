{
  "name": "@auditforge/test-helpers",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Shared test fixtures, factories, and doubles for AuditForge unit/integration/e2e tests",
  "license": "BUSL-1.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fixtures": "./src/fixtures/index.ts",
    "./pg-stub": "./src/pg-stub.ts",
    "./ledger-double": "./src/ledger-double.ts",
    "./webauthn-sim": "./src/webauthn-sim.ts",
    "./llm-mock": "./src/llm-mock.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:airgap": "vitest run tests/airgap-isolation.spec.ts",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.2",
    "vitest": "^4.1.0"
  }
}
