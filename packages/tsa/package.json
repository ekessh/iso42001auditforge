{
  "name": "@auditforge/tsa",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "RFC 3161 TimeStamp client. Encodes TimeStampReq, dispatches to a configurable TSA URL, parses TimeStampResp and exposes verify(token, expectedHash).",
  "license": "BUSL-1.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./asn1": "./src/asn1.ts",
    "./rfc3161": "./src/rfc3161.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@auditforge/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.2",
    "vitest": "^4.1.6"
  }
}
