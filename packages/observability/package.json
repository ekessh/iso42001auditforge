{
  "name": "@auditforge/observability",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "AuditForge shared observability primitives — OTel init, prom-client registry, pino factory, span helpers (Apache-2.0 / BUSL-1.1 dual)",
  "license": "Apache-2.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./otel": "./src/otel.ts",
    "./logger": "./src/logger.ts",
    "./metrics": "./src/metrics.ts",
    "./spans": "./src/spans.ts",
    "./correlate": "./src/correlate.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.50.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.53.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.53.0",
    "@opentelemetry/resources": "^1.26.0",
    "@opentelemetry/sdk-node": "^0.53.0",
    "@opentelemetry/sdk-trace-base": "^1.26.0",
    "@opentelemetry/semantic-conventions": "^1.27.0",
    "pino": "^9.4.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
