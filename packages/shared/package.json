{
  "name": "@auditforge/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "AuditForge cross-cutting types, Zod validators, error classes, Result helpers",
  "license": "BUSL-1.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/errors.ts",
    "./ids": "./src/ids.ts",
    "./result": "./src/result.ts",
    "./validators": "./src/validators.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "fast-check": "^3.22.0",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  }
}
