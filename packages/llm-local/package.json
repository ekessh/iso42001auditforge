{
  "name": "@auditforge/llm-local",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "AuditForge ISO 42001 local-LLM backend (default per ADR-0005): adapters for Ollama (default) and vLLM (optional), with streaming/non-streaming generate, chat, and embed APIs and health/model-management helpers.",
  "license": "BUSL-1.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./ollama": "./src/ollama.ts",
    "./vllm": "./src/vllm.ts",
    "./factory": "./src/factory.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@auditforge/shared": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@auditforge/shared": { "optional": true }
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^4.1.6",
    "typescript": "^5.6.2",
    "vitest": "^4.1.6"
  }
}
