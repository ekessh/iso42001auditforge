{
  "name": "@auditforge/peer-review",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "AuditForge ISO 42001 peer review: pre-issuance quality checklist workflow, reviewer-independence invariants, scoring, CB-customizable templates (Section 3.12, Phase 12).",
  "license": "BUSL-1.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./domain": "./src/domain/index.ts",
    "./workflow": "./src/workflow/index.ts",
    "./registry": "./src/registry/index.ts",
    "./scoring": "./src/scoring/index.ts",
    "./invariants": "./src/invariants/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@auditforge/shared": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  }
}
