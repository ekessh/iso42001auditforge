{
  "name": "@auditforge/working-papers",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "AuditForge ISO 42001 working papers: domain types, Yjs CRDT sync adapter, template registry, verdict state machine, conflict reconciler, cross-WP search interface.",
  "license": "BUSL-1.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./templates": "./src/templates/index.ts",
    "./templates/*": "./templates/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@auditforge/shared": "workspace:*",
    "yjs": "^13.6.18",
    "y-protocols": "^1.0.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  }
}
