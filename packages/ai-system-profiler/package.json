{
  "name": "@auditforge/ai-system-profiler",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "AuditForge ISO 42001 Phase 2: AI System intake, profiling, data-flow mapping, risk classification (EU AI Act / NIST AI RMF / MIT AIR / AVID / ATLAS), and pluggable importers (XLSX/JSON/MLflow/W&B/HuggingFace/OpenAPI).",
  "license": "BUSL-1.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./services": "./src/services/index.ts",
    "./importers": "./src/importers/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@auditforge/audit-engine": "workspace:*",
    "@auditforge/catalogues": "workspace:*",
    "@auditforge/db": "workspace:*",
    "@auditforge/shared": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@auditforge/audit-engine": { "optional": true },
    "@auditforge/catalogues": { "optional": true },
    "@auditforge/db": { "optional": true },
    "@auditforge/shared": { "optional": true }
  },
  "dependencies": {
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^2.1.1",
    "fast-check": "^3.22.0",
    "typescript": "^5.6.2",
    "vitest": "^4.1.0"
  }
}
