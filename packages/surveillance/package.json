{
  "name": "@auditforge/surveillance",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "AuditForge ISO 42001 Continuous Surveillance: signed/rate-limited telemetry ingest, threshold alerting with hysteresis, risk re-scoring, scope adjustment, and incident watch (per A.5.5).",
  "license": "BUSL-1.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./domain": "./src/domain.ts",
    "./telemetry-ingest": "./src/telemetry-ingest.ts",
    "./threshold-evaluator": "./src/threshold-evaluator.ts",
    "./alert-dispatcher": "./src/alert-dispatcher.ts",
    "./risk-score-engine": "./src/risk-score-engine.ts",
    "./scope-adjuster": "./src/scope-adjuster.ts",
    "./incident-watch": "./src/incident-watch.ts",
    "./signing": "./src/signing.ts",
    "./rate-limit": "./src/rate-limit.ts",
    "./surveillance-plan": "./src/surveillance-plan.ts",
    "./anomaly-detector": "./src/anomaly-detector.ts",
    "./timeline": "./src/timeline.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@auditforge/shared": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.2",
    "vitest": "^4.1.6"
  }
}
