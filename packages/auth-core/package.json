{
  "name": "@auditforge/auth-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Framework-agnostic auth primitives: OIDC client, WebAuthn registration/auth, RBAC matrix, JWT helpers, argon2id hashing.",
  "license": "BUSL-1.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./rbac": "./src/rbac.ts",
    "./oidc": "./src/oidc.ts",
    "./webauthn": "./src/webauthn.ts",
    "./jwt": "./src/jwt.ts",
    "./password": "./src/password.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@auditforge/shared": "workspace:*",
    "@simplewebauthn/server": "^11.0.0",
    "@simplewebauthn/types": "^11.0.0",
    "argon2": "^0.41.1",
    "jose": "^5.9.0",
    "openid-client": "^6.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "fast-check": "^3.22.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.1"
  }
}
