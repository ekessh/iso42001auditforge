{
  "name": "@auditforge/report-engine",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "AuditForge ISO 42001 Report Engine: Stage 1/2/Surveillance/Recertification templates, DOCX/PDF/A-3/XLSX renderers, hardware-backed CAdES-LT/PAdES-LTV signatures with TSA timestamps, multi-signer support, draft history with diff, immutable signed finals, CB letterhead injection.",
  "license": "BUSL-1.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./templates": "./src/templates/index.ts",
    "./renderers": "./src/renderers/index.ts",
    "./renderers/docx": "./src/renderers/docx.ts",
    "./renderers/pdf": "./src/renderers/pdf.ts",
    "./renderers/xlsx": "./src/renderers/xlsx.ts",
    "./signing": "./src/signing/index.ts",
    "./signing/cades": "./src/signing/cades.ts",
    "./signing/pades": "./src/signing/pades.ts",
    "./signing/tsa": "./src/signing/tsa.ts",
    "./signing/verify": "./src/signing/verify.ts",
    "./versioning": "./src/versioning/index.ts",
    "./branding": "./src/branding/index.ts",
    "./substitution": "./src/substitution/index.ts",
    "./export": "./src/export/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@auditforge/audit-engine": "workspace:*",
    "@auditforge/shared": "workspace:*",
    "@auditforge/signing": "workspace:*",
    "@auditforge/tsa": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "fast-check": "^3.22.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.1"
  }
}
