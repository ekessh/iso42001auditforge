{
  "name": "@auditforge/llm-cloud",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "AuditForge ISO 42001 cloud-LLM backend (opt-in only): adapters for Anthropic + OpenAI with prompt caching, cost tracking, PII scrubber pre-call hook, output classifier post-call hook, and per-engagement consent enforcement.",
  "license": "BUSL-1.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./consent": "./src/consent.ts",
    "./hooks": "./src/hooks.ts",
    "./cost": "./src/cost.ts",
    "./anthropic": "./src/anthropic.ts",
    "./openai": "./src/openai.ts",
    "./factory": "./src/factory.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@auditforge/llm-local": "workspace:*",
    "@auditforge/shared": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@auditforge/llm-local": { "optional": true },
    "@auditforge/shared": { "optional": true }
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^4.1.6",
    "typescript": "^5.6.2",
    "vitest": "^4.1.6"
  }
}
