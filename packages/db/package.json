{
  "name": "@auditforge/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Drizzle ORM schema, migrations, and seeders for AuditForge ISO 42001.",
  "license": "BUSL-1.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate": "drizzle-kit migrate",
    "migrate:up": "drizzle-kit migrate",
    "migrate:generate": "drizzle-kit generate",
    "generate": "drizzle-kit generate",
    "studio": "drizzle-kit studio",
    "seed": "tsx src/seed/index.ts",
    "test": "vitest run",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@auditforge/auth-core": "workspace:*",
    "@auditforge/catalogues": "workspace:*",
    "@auditforge/shared": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "pg": "^8.13.0",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "@testcontainers/postgresql": "^10.13.0",
    "drizzle-kit": "^0.28.0",
    "testcontainers": "^10.13.0",
    "tsx": "^4.19.1",
    "typescript": "^6.0.3",
    "vitest": "^2.1.1"
  }
}
