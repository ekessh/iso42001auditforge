{
  "$schema": "https://grafana.com/schemas/dashboard/v10.0.0",
  "uid": "auditforge-surveillance",
  "title": "AuditForge - Surveillance",
  "tags": ["auditforge", "surveillance", "iso17021"],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-7d", "to": "now" },
  "refresh": "60s",
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus", "current": { "text": "Prometheus", "value": "Prometheus" } }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ingest accepted / sec",
      "datasource": "$datasource",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(auditforge_surveillance_ingest_total{result=\"accepted\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Ingest rejected (last 5 min)",
      "datasource": "$datasource",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(auditforge_surveillance_ingest_total{result=\"rejected\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Ingest success rate",
      "datasource": "$datasource",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "(sum(rate(auditforge_surveillance_ingest_total{result=\"accepted\"}[5m])) / clamp_min(sum(rate(auditforge_surveillance_ingest_total[5m])), 1)) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Open critical flags",
      "datasource": "$datasource",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "auditforge_surveillance_flags_open{severity=\"critical\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Ingest rate by result",
      "datasource": "$datasource",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (result) (rate(auditforge_surveillance_ingest_total[1m]))",
          "refId": "A",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Anomaly flags raised",
      "datasource": "$datasource",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 13 },
      "targets": [
        {
          "expr": "sum by (rule_id, severity) (increase(auditforge_surveillance_flags_total[1h]))",
          "refId": "A",
          "legendFormat": "{{rule_id}} ({{severity}})"
        }
      ]
    }
  ]
}
