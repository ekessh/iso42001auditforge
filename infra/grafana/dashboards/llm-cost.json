{
  "$schema": "https://grafana.com/schemas/dashboard/v10.0.0",
  "uid": "auditforge-llm-cost",
  "title": "AuditForge - LLM Cost",
  "tags": ["auditforge", "llm", "cost"],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "60s",
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus", "current": { "text": "Prometheus", "value": "Prometheus" } },
      { "name": "provider", "type": "query", "datasource": "$datasource", "query": "label_values(auditforge_llm_call_cost_usd_total, provider)", "includeAll": true, "multi": true, "current": { "text": "All", "value": "$__all" } },
      { "name": "engagement_hashed", "type": "query", "datasource": "$datasource", "query": "label_values(auditforge_llm_call_cost_usd_total{provider=~\"$provider\"}, engagement_hashed)", "includeAll": true, "multi": true, "current": { "text": "All", "value": "$__all" } }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "$ / hr (overall)",
      "datasource": "$datasource",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(auditforge_llm_call_cost_usd_total{provider=~\"$provider\",engagement_hashed=~\"$engagement_hashed\"}[5m])) * 3600",
          "refId": "A",
          "legendFormat": "$/hr"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Calls / sec",
      "datasource": "$datasource",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(auditforge_llm_call_duration_ms_count{provider=~\"$provider\"}[5m]))",
          "refId": "A",
          "legendFormat": "calls/sec"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Median latency (ms)",
      "datasource": "$datasource",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(auditforge_llm_call_duration_ms_bucket{provider=~\"$provider\"}[5m])))",
          "refId": "A",
          "legendFormat": "p50"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p99 latency (ms)",
      "datasource": "$datasource",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(auditforge_llm_call_duration_ms_bucket{provider=~\"$provider\"}[5m])))",
          "refId": "A",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cost rate by provider",
      "datasource": "$datasource",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (provider) (rate(auditforge_llm_call_cost_usd_total{provider=~\"$provider\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cost rate by engagement (hashed)",
      "datasource": "$datasource",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum by (engagement_hashed) (rate(auditforge_llm_call_cost_usd_total{engagement_hashed=~\"$engagement_hashed\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{engagement_hashed}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99 by tier (task)",
      "datasource": "$datasource",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 13 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, task) (rate(auditforge_llm_call_duration_ms_bucket{provider=~\"$provider\"}[5m])))",
          "refId": "A",
          "legendFormat": "p50 - {{task}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, task) (rate(auditforge_llm_call_duration_ms_bucket{provider=~\"$provider\"}[5m])))",
          "refId": "B",
          "legendFormat": "p95 - {{task}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, task) (rate(auditforge_llm_call_duration_ms_bucket{provider=~\"$provider\"}[5m])))",
          "refId": "C",
          "legendFormat": "p99 - {{task}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top engagements by 24h cost",
      "datasource": "$datasource",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "targets": [
        {
          "expr": "topk(10, sum by (engagement_hashed) (increase(auditforge_llm_call_cost_usd_total[24h])))",
          "refId": "A",
          "format": "table"
        }
      ]
    }
  ]
}
