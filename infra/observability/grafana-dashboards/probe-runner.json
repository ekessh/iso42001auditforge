{
  "$schema": "https://grafana.com/schemas/dashboard/v10.0.0",
  "uid": "auditforge-probe-runner",
  "title": "AuditForge — Probe Runner",
  "tags": ["auditforge", "probes", "slo"],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus", "current": { "text": "Prometheus", "value": "Prometheus" } },
      { "name": "queue", "type": "query", "datasource": "$datasource", "query": "label_values(auditforge_probe_queue_depth, queue)", "includeAll": true, "multi": true, "current": { "text": "All", "value": "$__all" } }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Queue depth",
      "datasource": "$datasource",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "max(auditforge_probe_queue_depth{queue=~\"$queue\"})", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Success rate (5m)",
      "datasource": "$datasource",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "1 - (sum(rate(auditforge_probe_duration_ms_count{status=\"error\"}[5m])) / clamp_min(sum(rate(auditforge_probe_duration_ms_count[5m])),1))", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Sandbox violations (1h)",
      "datasource": "$datasource",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(increase(auditforge_probe_duration_ms_count{mode=\"violation\"}[1h]))", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Budget breaches (1h)",
      "datasource": "$datasource",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "count(max by (engagement_hashed) (auditforge_probe_budget_used_usd) > 50)", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Probe queue depth",
      "datasource": "$datasource",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "auditforge_probe_queue_depth{queue=~\"$queue\"}", "refId": "A", "legendFormat": "{{queue}}" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Probe latency p50/p95/p99",
      "datasource": "$datasource",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(auditforge_probe_duration_ms_bucket[5m])) by (le))", "refId": "A", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(auditforge_probe_duration_ms_bucket[5m])) by (le))", "refId": "B", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(auditforge_probe_duration_ms_bucket[5m])) by (le))", "refId": "C", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Top probes by failure rate (1h)",
      "datasource": "$datasource",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "topk(10, sum by (probe_id) (rate(auditforge_probe_duration_ms_count{status=\"error\"}[1h])))", "refId": "A", "format": "table", "instant": true }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Per-engagement budget consumption",
      "datasource": "$datasource",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "auditforge_probe_budget_used_usd", "refId": "A", "legendFormat": "{{engagement_hashed}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    }
  ]
}
