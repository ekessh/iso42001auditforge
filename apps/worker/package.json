    "@opentelemetry/sdk-node": "^0.217.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.53.0",
    "@opentelemetry/auto-instrumentations-node": "^0.50.0",
    "bullmq": "^5.13.2",
    "ioredis": "^5.4.1",
    "minio": "^8.0.1",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "prom-client": "^15.1.3",
    "undici": "^6.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^2.1.1",
    "testcontainers": "^10.13.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
