{
  "name": "@auditforge/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "AuditForge ISO 42001 — BullMQ workers (probe runner, AV, OCR, report render) (BUSL-1.1)",
  "license": "BUSL-1.1",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
