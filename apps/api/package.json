{
  "name": "@auditforge/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "AuditForge ISO 42001 — NestJS modular monolith API (BUSL-1.1)",
  "license": "BUSL-1.1",
  "scripts": {
    "build": "nest build && pnpm openapi:emit",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "openapi:emit": "node --import @swc-node/register/esm-register scripts/emit-openapi.ts",
    "emit-openapi": "node --import @swc-node/register/esm-register scripts/emit-openapi.ts",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@auditforge/ai-system-profiler": "workspace:*",
