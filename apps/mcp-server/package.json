{
  "name": "@auditforge/mcp-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "AuditForge ISO 42001 - MCP server exposing engagement data to MCP-compatible clients (Claude Desktop, Cursor, Copilot Workspace). Per v3 Section 15.16 #5 + Section 18.5.",
  "license": "BUSL-1.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "auditforge-mcp": "./bin/auditforge-mcp.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./auth": "./src/auth.ts",
    "./audit": "./src/audit.ts",
    "./rbac": "./src/rbac.ts",
    "./tools": "./src/tools/index.ts",
    "./resources": "./src/resources/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@auditforge/shared": "workspace:*",
    "@auditforge/catalogues": "workspace:*",
    "@auditforge/signing": "workspace:*",
    "@auditforge/mcp-tools": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.1"
  }
}
